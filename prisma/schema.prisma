generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  fullName  String?
  password  String
  role      String   // 'ADMIN' or 'DEAN'
  facultyId String?  // nullable if ADMIN
  faculty   Faculty? @relation(fields: [facultyId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Faculty {
  id          String       @id @default(uuid())
  name        String       @unique
  users       User[]
  students    Student[]
  teachers    Teacher[]
  literatures Literature[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Student {
  id           String        @id @default(uuid())
  fullName     String
  pinfl        String        @unique // JSHSHIR yoki pasport
  birthDate    String?
  phone        String?
  direction    String?       // Yo'nalish (Excelda yo'q, lekin filtr uchun kerak)
  groupName    String?       // Guruh
  facultyId    String
  faculty      Faculty       @relation(fields: [facultyId], references: [id])
  certificates Certificate[]
  district     String?       // Tuman
  address      String?       // Yashash manzili
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Certificate {
  id           String   @id @default(uuid())
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  language     String   // Ingliz, Nemis, etc.
  issueDate    String?
  certNumber   String   @unique
  level        String   // B2, C1, etc.
  type         String?  // Xalqaro, Milliy
  fileUrl      String?  // Sertifikat faylining linki (pdf yoki rasm)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Teacher {
  id           String               @id @default(uuid())
  fullName     String
  pinfl        String               @unique // JSHSHIR yoki pasport
  birthDate    String?
  phone        String?
  department   String?              // Kafedra
  position     String?              // Lavozimi
  facultyId    String
  faculty      Faculty              @relation(fields: [facultyId], references: [id])
  certificates TeacherCertificate[]
  district     String?              // Tuman
  address      String?              // Yashash manzili
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}

model TeacherCertificate {
  id           String   @id @default(uuid())
  teacherId    String
  teacher      Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  language     String   // Ingliz, Nemis, etc.
  issueDate    String?
  certNumber   String   @unique
  level        String   // B2, C1, etc.
  type         String?  // Xalqaro, Milliy
  fileUrl      String?  // Sertifikat faylining linki (pdf yoki rasm)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Literature {
  id          String   @id @default(uuid())
  facultyId   String
  faculty     Faculty  @relation(fields: [facultyId], references: [id])
  department  String?  // Kafedra
  author      String   // Muallif (F.I.Sh)
  coAuthors   String?  // Hammualliflar
  title       String   // Adabiyot nomi
  type        String   // O'quv qo'llanma, Uslubiy qo'llanma, Monografiya, Darslik
  publishDate String?  // Chop etilgan sana
  fileUrl     String?  // Kitob faylining linki (pdf)
  grifUrl     String?  // Grif faylining linki (pdf yoki rasm)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

